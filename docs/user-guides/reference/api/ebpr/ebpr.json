{
  "openapi": "3.1.0",
  "info": {
    "title": "Flowchem - ",
    "description": "Flowchem is a library to control instruments and devices commonly found in chemistry labs via an interoperable web API.",
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.1.1"
  },
  "paths": {
    "/my-ebpr/": {
      "get": {
        "tags": [
          "my-ebpr"
        ],
        "summary": "Get Device Info",
        "operationId": "get_device_info_my_ebpr__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceInfo"
                }
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/": {
      "get": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Get Component Info",
        "description": "Retrieve the component's metadata.\n\nThis endpoint provides information about the component, such as its name and associated hardware device.\n\nReturns:\n--------\nComponentInfo\n    Metadata about the component.",
        "operationId": "get_component_info_my_ebpr_pressure__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentInfo"
                }
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/is-reachable": {
      "get": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Is Reachable",
        "description": "Return ONLINE if the pressure controller responds to a pressure query.",
        "operationId": "is_reachable_my_ebpr_pressure_is_reachable_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReachabilityStatus"
                }
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/is-idle": {
      "get": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Is Idle",
        "description": "Check whether any in-progress physical action has finished.\n\nSubclasses should override this with a real hardware busy/idle probe where\navailable. Returns True by default when completion can't be verified.",
        "operationId": "is_idle_my_ebpr_pressure_is_idle_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "title": "Response Is Idle My Ebpr Pressure Is Idle Get"
                }
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/pressure": {
      "put": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Set Pressure",
        "description": "Set the target pressure (default unit mbar if none given).",
        "operationId": "set_pressure_my_ebpr_pressure_pressure_put",
        "parameters": [
          {
            "name": "pressure",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pressure"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Get Pressure",
        "description": "Get the current pressure in bar.",
        "operationId": "get_pressure_my_ebpr_pressure_pressure_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "number",
                  "title": "Response Get Pressure My Ebpr Pressure Pressure Get"
                }
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/power-on": {
      "put": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Power On",
        "description": "Turn on pressure control.",
        "operationId": "power_on_my_ebpr_pressure_power_on_put",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/power-off": {
      "put": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Power Off",
        "description": "Turn off pressure control.",
        "operationId": "power_off_my_ebpr_pressure_power_off_put",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/my-ebpr/pressure/target-reached": {
      "get": {
        "tags": [
          "my-ebpr",
          "my-ebpr"
        ],
        "summary": "Is Target Reached",
        "description": "Check if the current pressure is within the eBPR's documented resolution of the set point.",
        "operationId": "is_target_reached_my_ebpr_pressure_target_reached_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean",
                  "title": "Response Is Target Reached My Ebpr Pressure Target Reached Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "parent_device": {
            "type": "string",
            "title": "Parent Device",
            "default": ""
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": ""
          },
          "corresponding_class": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Corresponding Class",
            "default": []
          },
          "owl_subclass_of": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owl Subclass Of",
            "default": [
              "http://purl.obolibrary.org/obo/OBI_0000968"
            ]
          }
        },
        "type": "object",
        "title": "ComponentInfo",
        "description": "Metadata associated with flowchem components."
      },
      "DeviceInfo": {
        "properties": {
          "manufacturer": {
            "type": "string",
            "title": "Manufacturer",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": ""
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Serial Number",
            "default": "unknown"
          },
          "components": {
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "type": "object",
            "title": "Components",
            "default": {}
          },
          "backend": {
            "type": "string",
            "title": "Backend",
            "default": "flowchem v. 1.1.1"
          },
          "authors": {
            "items": {
              "type": "string",
              "format": "name-email"
            },
            "type": "array",
            "title": "Authors",
            "default": []
          },
          "additional_info": {
            "type": "object",
            "title": "Additional Info",
            "default": {}
          }
        },
        "type": "object",
        "title": "DeviceInfo",
        "description": "Metadata associated with hardware devices."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReachabilityStatus": {
        "type": "string",
        "enum": [
          "online",
          "offline",
          "unknown"
        ],
        "title": "ReachabilityStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}